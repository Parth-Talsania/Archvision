# ArchVision Backend — Environment Variables
# Copy this file to .env and fill in real values.

# ── Security ──────────────────────────────────────────────
ARCHVISION_SECRET_KEY=change-me-to-a-random-secret
ARCHVISION_TOKEN_EXPIRE=1440              # JWT lifetime in minutes (default 24h)

# ── Database ──────────────────────────────────────────────
# ARCHVISION_DATABASE_URL=sqlite:///backend/archvision.db

# ── YOLO Model ────────────────────────────────────────────
# ARCHVISION_MODEL_PATH=/path/to/best.pt

# ── OAuth: Google ─────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── OAuth: GitHub ─────────────────────────────────────────
# Create an OAuth App at https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Frontend URL (used for OAuth callback redirects) ──────
ARCHVISION_FRONTEND_URL=http://localhost:8080
